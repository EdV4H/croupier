{
  "name": "@edv4h/croupier-core",
  "version": "0.1.0",
  "description": "Turn-based multiplayer game engine: phases, turn orders, actions, bots, view masking and snapshots",
  "license": "MIT",
  "author": "Yusuke Maruyama",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "xstate": "^5.28.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdV4H/croupier.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/EdV4H/croupier#readme",
  "bugs": {
    "url": "https://github.com/EdV4H/croupier/issues"
  }
}
