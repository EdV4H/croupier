{
  "name": "@edv4h/croupier-trading-card",
  "version": "0.0.0",
  "description": "Headless React trading card for croupier: pointer tilt, glare, flip, drag rotation and reveal effects, with a skeleton stylesheet",
  "license": "MIT",
  "author": "Yusuke Maruyama",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@ark-ui/react": "^5.40.0",
    "@zag-js/anatomy": "^1.48.0",
    "@zag-js/core": "^1.48.0",
    "@zag-js/react": "^1.48.0",
    "@zag-js/types": "^1.48.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ark-ui/react": "5.40.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@zag-js/anatomy": "1.48.0",
    "@zag-js/core": "1.48.0",
    "@zag-js/react": "1.48.0",
    "@zag-js/types": "1.48.0",
    "jsdom": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdV4H/croupier.git",
    "directory": "packages/trading-card"
  },
  "homepage": "https://github.com/EdV4H/croupier#readme",
  "bugs": {
    "url": "https://github.com/EdV4H/croupier/issues"
  }
}
