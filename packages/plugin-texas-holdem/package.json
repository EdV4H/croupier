{
  "name": "@edv4h/croupier-plugin-texas-holdem",
  "version": "0.1.0",
  "description": "Texas Hold'em plugin for @edv4h/croupier-core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdV4H/croupier.git",
    "directory": "packages/plugin-texas-holdem"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@edv4h/croupier-core": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
