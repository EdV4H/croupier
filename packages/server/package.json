{
  "name": "@croupier/server",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-agnostic game room server for Croupier: one room core, adapters for Node and Cloudflare Durable Objects",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts",
    "./node": "./src/adapters/node.ts",
    "./cloudflare": "./src/adapters/cloudflare.ts"
  },
  "scripts": {
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.workers.json"
  },
  "dependencies": {
    "@edv4h/croupier-core": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@hono/node-ws": "^1.1.0",
    "hono": "^4.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "3.2.4",
    "ws": "^8.18.0"
  }
}
